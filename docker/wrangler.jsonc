// Container config: same Worker, no Cloudflare account, routes or ids.
// R2 buckets are local files under /data.
{
  "name": "dumpen",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "secrets": {
    "required": [
      "PUBLIC_ASSET_ORIGIN", "GALLERY_PREFIX", "AUTH_MODE", "ADMIN_PASSWORD",
      "CF_ACCESS_TEAM_DOMAIN", "CF_ACCESS_AUD", "WORKERS_API_TOKEN", "CF_ACCESS_ACCOUNT_ID"
    ]
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "GALLERY_BUCKET", "bucket_name": "gallery" },
    { "binding": "LEGACY_BUCKET", "bucket_name": "legacy" }
  ]
}
